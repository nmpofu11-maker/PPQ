# ---- Server (all optional unless noted) ----
PORT=3000

# Required for AI tactical briefs.
GEMINI_API_KEY=""
# Override only if you need a different model; verify the ID in the Gemini API docs first.
# GEMINI_MODEL="gemini-3.8-flash"

# Required (with the web client config) so the server can verify Firebase sign-in tokens for AI briefs.
# This is the same public Web API key found in firebase-applet-config.json.
FIREBASE_API_KEY=""

# Daily AI budget (calls per UTC day). Defaults: 300 global, 40 per user.
# AI_DAILY_LIMIT_GLOBAL=300
# AI_DAILY_LIMIT_PER_USER=40

# Background Web Push. Without both keys the push endpoints answer 503 in production.
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Where push subscriptions are stored (JSON file). Use a persistent volume in production.
# PUSH_STORE_PATH=".data/push-subscriptions.json"
# Extra push-service hosts to allow (comma separated); the built-in list covers FCM, Mozilla, Apple, Windows.
# PUSH_ENDPOINT_ALLOWLIST=""

# Number of reverse proxies in front of the app (for correct client IPs / rate limits). Default 1 in production.
# TRUST_PROXY=1

# Directory of built client files (default ./dist in production).
# STATIC_DIR="dist"
