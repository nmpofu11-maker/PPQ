rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    function isOwnerRead(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'minEvThreshold', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'minEvThreshold', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.minEvThreshold is number && data.minEvThreshold >= 0 && data.minEvThreshold <= 50
        && data.updatedAt == request.time;
    }

    function isValidModelState(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'sync_timestamp', 'model_engine', 'meta_improvement_notes',
          'momentumSensitivity', 'shotOnTargetWeight', 'possessionWeight',
          'cornerPressureWeight', 'baseTempoBias', 'homeAdvantageBase',
          'totalEvaluated', 'correctPredictions', 'cumulativeBrier',
          'cumulativeLogLoss', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'sync_timestamp', 'model_engine', 'meta_improvement_notes',
          'momentumSensitivity', 'shotOnTargetWeight', 'possessionWeight',
          'cornerPressureWeight', 'baseTempoBias', 'homeAdvantageBase',
          'totalEvaluated', 'correctPredictions', 'cumulativeBrier',
          'cumulativeLogLoss', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.sync_timestamp is string && data.sync_timestamp.size() >= 10 && data.sync_timestamp.size() <= 64
        && data.model_engine is string && data.model_engine.size() >= 2 && data.model_engine.size() <= 120
        && data.meta_improvement_notes is string && data.meta_improvement_notes.size() >= 1 && data.meta_improvement_notes.size() <= 1000
        && data.momentumSensitivity is number && data.momentumSensitivity >= 0.05 && data.momentumSensitivity <= 2.5
        && data.shotOnTargetWeight is number && data.shotOnTargetWeight >= 0.01 && data.shotOnTargetWeight <= 2.0
        && data.possessionWeight is number && data.possessionWeight >= 0.0 && data.possessionWeight <= 2.0
        && data.cornerPressureWeight is number && data.cornerPressureWeight >= 0.0 && data.cornerPressureWeight <= 2.0
        && data.baseTempoBias is number && data.baseTempoBias >= -1.0 && data.baseTempoBias <= 1.0
        && data.homeAdvantageBase is number && data.homeAdvantageBase >= 0.75 && data.homeAdvantageBase <= 1.5
        && data.totalEvaluated is int && data.totalEvaluated >= 0 && data.totalEvaluated <= 1000000
        && data.correctPredictions is int && data.correctPredictions >= 0 && data.correctPredictions <= data.totalEvaluated
        && data.cumulativeBrier is number && data.cumulativeBrier >= 0 && data.cumulativeBrier <= 1000000
        && data.cumulativeLogLoss is number && data.cumulativeLogLoss >= 0 && data.cumulativeLogLoss <= 10000000
        && data.updatedAt == request.time;
    }

    function isValidTeamIntelligence(data, userId, teamId) {
      return data.keys().hasAll([
          'ownerId', 'teamKey', 'teamName', 'sample_size_matches',
          'home_advantage_multiplier', 'form_momentum_weight',
          'volatility_index', 'fatigue_penalty_modifier', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'teamKey', 'teamName', 'sample_size_matches',
          'home_advantage_multiplier', 'form_momentum_weight',
          'volatility_index', 'fatigue_penalty_modifier', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.teamKey is string && data.teamKey == teamId && isValidId(data.teamKey)
        && data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 120
        && data.sample_size_matches is int && data.sample_size_matches >= 0 && data.sample_size_matches <= 100000
        && data.home_advantage_multiplier is number && data.home_advantage_multiplier >= 0.5 && data.home_advantage_multiplier <= 2.0
        && data.form_momentum_weight is number && data.form_momentum_weight >= 0.1 && data.form_momentum_weight <= 3.0
        && data.volatility_index is number && data.volatility_index >= 0.3 && data.volatility_index <= 3.0
        && data.fatigue_penalty_modifier is number && data.fatigue_penalty_modifier >= 0.4 && data.fatigue_penalty_modifier <= 2.5
        && data.updatedAt == request.time;
    }

    function isValidAuditLog(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'matchId', 'league', 'homeTeam', 'awayTeam',
          'finalScore', 'snapshotMinute', 'market', 'selection',
          'modelProbability', 'actualOutcome', 'isCorrect', 'brierScore', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'matchId', 'league', 'homeTeam', 'awayTeam',
          'finalScore', 'snapshotMinute', 'snapshotSource', 'market', 'selection',
          'modelProbability', 'impliedProbability', 'evPct',
          'actualOutcome', 'isCorrect', 'brierScore', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.matchId is string && isValidId(data.matchId)
        && data.league is string && data.league.size() >= 1 && data.league.size() <= 120
        && data.homeTeam is string && data.homeTeam.size() >= 1 && data.homeTeam.size() <= 120
        && data.awayTeam is string && data.awayTeam.size() >= 1 && data.awayTeam.size() <= 120
        && data.finalScore is string && data.finalScore.size() >= 3 && data.finalScore.size() <= 20
        && data.snapshotMinute is int && data.snapshotMinute >= 1 && data.snapshotMinute <= 120
        && (!('snapshotSource' in data) || (data.snapshotSource is string && data.snapshotSource in ['exact_live_capture', 'causal_reconstruction']))
        && data.market is string && data.market.size() >= 1 && data.market.size() <= 80
        && data.selection is string && data.selection.size() >= 1 && data.selection.size() <= 80
        && data.modelProbability is number && data.modelProbability >= 0.0 && data.modelProbability <= 1.0
        && (!('impliedProbability' in data) || (data.impliedProbability is number && data.impliedProbability >= 0.0 && data.impliedProbability <= 1.0))
        && (!('evPct' in data) || (data.evPct is number && data.evPct >= -100.0 && data.evPct <= 1000.0))
        && data.actualOutcome is string && data.actualOutcome.size() >= 1 && data.actualOutcome.size() <= 40
        && data.isCorrect is bool
        && data.brierScore is number && data.brierScore >= 0.0 && data.brierScore <= 2.0
        && data.createdAt == request.time;
    }

    function isValidTrendAlert(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'matchId', 'teamName', 'patternLabel',
          'bestMarketPick', 'tacticalVerdict', 'dangerQualitySummary',
          'minute', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'matchId', 'teamName', 'patternLabel',
          'bestMarketPick', 'tacticalVerdict', 'dangerQualitySummary',
          'minute', 'createdAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.matchId is string && isValidId(data.matchId)
        && data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 120
        && data.patternLabel is string && data.patternLabel.size() >= 1 && data.patternLabel.size() <= 160
        && data.bestMarketPick is string && data.bestMarketPick.size() >= 1 && data.bestMarketPick.size() <= 160
        && data.tacticalVerdict is string && data.tacticalVerdict.size() >= 1 && data.tacticalVerdict.size() <= 80
        && data.dangerQualitySummary is string && data.dangerQualitySummary.size() >= 1 && data.dangerQualitySummary.size() <= 600
        && data.minute is int && data.minute >= 0 && data.minute <= 120
        && data.createdAt == request.time;
    }

    function isValidPaperBet(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'matchId', 'league', 'matchTitle', 'homeTeam', 'awayTeam',
          'minutePlaced', 'scoreAtPlacement', 'market', 'selection', 'confidenceTier',
          'modelProbability', 'bookmakerOddsDecimal', 'bookmakerOddsAmerican',
          'evPct', 'stakeUnits', 'oddsVerifiedLive', 'status', 'profitUnits', 'placedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'matchId', 'league', 'matchTitle', 'homeTeam', 'awayTeam',
          'minutePlaced', 'scoreAtPlacement', 'market', 'selection', 'confidenceTier',
          'modelProbability', 'bookmakerOddsDecimal', 'bookmakerOddsAmerican',
          'evPct', 'stakeUnits', 'oddsVerifiedLive', 'status', 'finalScore',
          'profitUnits', 'placedAt', 'settledAt', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.matchId is string && isValidId(data.matchId)
        && data.league is string && data.league.size() >= 1 && data.league.size() <= 120
        && data.matchTitle is string && data.matchTitle.size() >= 1 && data.matchTitle.size() <= 200
        && data.homeTeam is string && data.homeTeam.size() >= 1 && data.homeTeam.size() <= 120
        && data.awayTeam is string && data.awayTeam.size() >= 1 && data.awayTeam.size() <= 120
        && data.minutePlaced is int && data.minutePlaced >= 0 && data.minutePlaced <= 120
        && data.scoreAtPlacement is string && data.scoreAtPlacement.size() >= 3 && data.scoreAtPlacement.size() <= 20
        && data.market is string && data.market.size() >= 1 && data.market.size() <= 80
        && data.selection is string && data.selection.size() >= 1 && data.selection.size() <= 120
        && data.confidenceTier is string && data.confidenceTier in ['Strong Edge', 'Moderate Edge', 'Watch']
        && data.modelProbability is number && data.modelProbability >= 0.0 && data.modelProbability <= 1.0
        && data.bookmakerOddsDecimal is number && data.bookmakerOddsDecimal >= 1.01 && data.bookmakerOddsDecimal <= 500.0
        && data.bookmakerOddsAmerican is string && data.bookmakerOddsAmerican.size() >= 1 && data.bookmakerOddsAmerican.size() <= 20
        && data.evPct is number && data.evPct >= -100.0 && data.evPct <= 2000.0
        && data.stakeUnits is number && data.stakeUnits >= 0.01 && data.stakeUnits <= 25.0
        && data.oddsVerifiedLive is bool
        && data.status is string && data.status in ['open', 'won', 'lost', 'push']
        && (!('finalScore' in data) || (data.finalScore is string && data.finalScore.size() >= 3 && data.finalScore.size() <= 20))
        && data.profitUnits is number && data.profitUnits >= -50.0 && data.profitUnits <= 5000.0
        && data.placedAt is string && data.placedAt.size() >= 10 && data.placedAt.size() <= 64
        && (!('settledAt' in data) || (data.settledAt is string && data.settledAt.size() >= 10 && data.settledAt.size() <= 64))
        && data.updatedAt == request.time;
    }

    function isValidLiveSnapshot(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'matchId', 'milestoneMinute', 'capturedMinute',
          'netMomentum', 'snapshotJson', 'capturedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'matchId', 'milestoneMinute', 'capturedMinute',
          'netMomentum', 'snapshotJson', 'capturedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.matchId is string && isValidId(data.matchId)
        && data.milestoneMinute is int && data.milestoneMinute in [30, 45, 60, 75]
        && data.capturedMinute is int && data.capturedMinute >= 1 && data.capturedMinute <= 120
        && data.netMomentum is number && data.netMomentum >= -200.0 && data.netMomentum <= 200.0
        && data.snapshotJson is string && data.snapshotJson.size() >= 2 && data.snapshotJson.size() <= 32768
        && data.capturedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwnerRead(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isVerifiedOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId) && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'minEvThreshold', 'updatedAt']);
      allow delete: if isValidId(userId) && isVerifiedOwner(userId);

      match /modelState/{stateId} {
        allow get: if isValidId(userId) && isValidId(stateId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(stateId) && isVerifiedOwner(userId)
          && isValidModelState(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(stateId) && isVerifiedOwner(userId)
          && isValidModelState(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'sync_timestamp', 'model_engine', 'meta_improvement_notes',
            'momentumSensitivity', 'shotOnTargetWeight', 'possessionWeight',
            'cornerPressureWeight', 'baseTempoBias', 'homeAdvantageBase',
            'totalEvaluated', 'correctPredictions', 'cumulativeBrier',
            'cumulativeLogLoss', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(stateId) && isVerifiedOwner(userId);
      }

      match /teamIntelligence/{teamId} {
        allow get: if isValidId(userId) && isValidId(teamId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(teamId) && isVerifiedOwner(userId)
          && isValidTeamIntelligence(incoming(), userId, teamId);
        allow update: if isValidId(userId) && isValidId(teamId) && isVerifiedOwner(userId)
          && isValidTeamIntelligence(incoming(), userId, teamId)
          && incoming().ownerId == existing().ownerId
          && incoming().teamKey == existing().teamKey
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'teamName', 'sample_size_matches', 'home_advantage_multiplier',
            'form_momentum_weight', 'volatility_index', 'fatigue_penalty_modifier', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(teamId) && isVerifiedOwner(userId);
      }

      match /auditLogs/{logId} {
        allow get: if isValidId(userId) && isValidId(logId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(logId) && isVerifiedOwner(userId)
          && isValidAuditLog(incoming(), userId);
        allow update: if false; // Immutable once recorded
        allow delete: if isValidId(userId) && isValidId(logId) && isVerifiedOwner(userId);
      }

      match /trendAlerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(alertId) && isVerifiedOwner(userId)
          && isValidTrendAlert(incoming(), userId);
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(alertId) && isVerifiedOwner(userId);
      }

      match /paperBets/{betId} {
        allow get: if isValidId(userId) && isValidId(betId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(betId) && isVerifiedOwner(userId)
          && isValidPaperBet(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(betId) && isVerifiedOwner(userId)
          && isValidPaperBet(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().matchId == existing().matchId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'finalScore', 'profitUnits', 'settledAt', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(betId) && isVerifiedOwner(userId);
      }

      match /liveSnapshots/{snapshotId} {
        allow get: if isValidId(userId) && isValidId(snapshotId) && isOwnerRead(userId);
        allow list: if isValidId(userId) && isOwnerRead(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(snapshotId) && isVerifiedOwner(userId)
          && isValidLiveSnapshot(incoming(), userId);
        allow update: if false; // Immutable milestone capture
        allow delete: if isValidId(userId) && isValidId(snapshotId) && isVerifiedOwner(userId);
      }
    }
  }
}
